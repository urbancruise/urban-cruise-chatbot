{
  "name": "urban-cruise-chatbot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 5001",
    "dev:realtime": "node --env-file=.env.local scripts/realtime-server.mjs",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:realtime\"",
    "build": "next build",
    "start": "next start --port 5001",
    "start:realtime": "node scripts/realtime-server.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "db:prune-chat-history": "node --env-file=.env.local scripts/prune-chat-history.mjs",
    "db:agent:create": "node --env-file=.env.local --import tsx scripts/create-agent.ts"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "next": "16.4.6",
    "nodemailer": "^10.6.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
